# Nospace Grammar
#
# 現在の言語仕様 (spec.md) に基づく BNF 定義
# 未実装の機能はコメントで注記

program ::= (func | global_stmt)*

## Tokens

integer ::= /[0-9]+/
char ::= /'([^\\\t\n\s']|\\[\\tns'r])*'/
ident ::= /[A-Za-z_][A-Za-z0-9_]*/

## Whitespace (allowed between every token)

space ::= /[ \t\n\v\f\r]/
comment ::= /#[^#]*#/

## Expressions

# 優先順位（低い順）:
#   1. 代入 (=)                    - 右結合
#   2. 論理OR (||)                 - 左結合、短絡評価
#   3. 論理AND (&&)                - 左結合、短絡評価
#   4. 比較 (==, !=, <, <=, >, >=) - 左結合
#   5. 加減算 (+, -)               - 左結合
#   6. 乗除剰余 (*, /, %)          - 左結合
#   7. 単項 (-, !, &, *)           - 右結合
#   8. インデックス ([])           - 未実装

expr ::= expr_assign
expr_assign ::= expr_or ("=" expr_assign)?

expr_or ::= expr_and ("||" expr_or)?
expr_and ::= expr_cmp ("&&" expr_and)?

expr_cmp ::= expr_add (("==" | "!=" | "<" | "<=" | ">" | ">=") expr_cmp)?

expr_add ::= expr_mul (("+" | "-") expr_add)?
expr_mul ::= expr_unary (("*" | "/" | "%") expr_mul)?

expr_unary ::=
    | ("-" | "!" | "&" | "*") expr_unary
    | expr_postfix

# 未実装: 配列インデックス
expr_postfix ::= expr_val
# expr_postfix ::= expr_val ("[" expr "]")?   # 未実装: 配列

expr_val ::=
    | integer
    | char
    | ident "(" (expr ("," expr)*)? ")"       # 関数呼び出し
    | ident
    | "(" expr ")"

## Statements

# グローバルスコープで許可される文
global_stmt ::=
    | let
    | expr ";"

func ::=
    | "func" ":" ident "(" (ident ("," ident)*)? ")" block

let ::=
    | "let" ":" let_decl ("," let_decl)* ";"

# 配列宣言は未実装
let_decl ::= ident ("(" expr ")")?
# let_decl ::= ident ("[" integer "]")?           # 未実装: 配列

stmt ::=
    | if_stmt
    | while_stmt
    | return_stmt
    | break_stmt
    | continue_stmt
    | let
    | func                                    # ネストした関数定義
    | expr ";"

# if 文
# 注: 旧仕様の elsif は廃止、else: if: で代用
if_stmt ::=
    | "if" ":" expr block ("else" ":" block)? ";"

# while 文
while_stmt ::=
    | "while" ":" expr block ";"

# return 文
return_stmt ::=
    | "return" ":" expr ";"
    | "return" ";"

# break / continue
break_stmt ::= "break" ";"
continue_stmt ::= "continue" ";"

block ::= "{" stmt* "}"

## 組み込み関数 (識別子として扱う)
#
# デバッグ・テスト用:
#   __clog(x)       - 値をコンソールに出力し、x を返す
#   __assert(x)     - x が 0 ならパニック
#   __assert_not(x) - x が 0 以外ならパニック
#   __trace(key)    - テスト用トレース記録
#
# 入出力:
#   __puti(x)       - 整数を出力
#   __putc(x)       - 文字（ASCII）を出力
#   __geti()        - 整数を入力
#   __getc()        - 1文字を入力

## 未実装機能
#
# - 複合代入演算子 (+=, -=, *=, /=, %=)
# - 配列 (let: arr[4];)
# - 配列アクセス (arr[i])
# - グローバル変数の初期値指定
# - 16進数リテラル (0x...)
# - 変数の初期値 (let: x(5);)
# - final / const 修飾子
