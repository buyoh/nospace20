{
  "description": "FSBA: alloc(1) で最小ブロック (class 0, block_size=2) を確保し、書き込み・読み取り",
  "config": { "allocator": "fsba" },
  "vars": ["p1"],
  "steps": [
    { "op": "alloc", "var": "p1", "size": 1 },
    { "op": "load_print", "var": "p1" },
    { "op": "free", "var": "p1" }
  ],
  "check": {
    "type": "alloc_io",
    "stdout": "1\n"
  }
}
