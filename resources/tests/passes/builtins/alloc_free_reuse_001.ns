# __alloc → 使用 → __free → 再確保 #
func: __main() {
    let: p1(__alloc(2));
    *p1 = 100;
    *(p1 + 1) = 200;
    __puti(*p1);
    __putc(10);
    __puti(*(p1 + 1));
    __putc(10);
    __free(p1);

    # 再確保: 同じサイズクラスなので同じブロックが再利用される可能性が高い #
    let: p2(__alloc(2));
    *p2 = 300;
    *(p2 + 1) = 400;
    __puti(*p2);
    __putc(10);
    __puti(*(p2 + 1));
    __putc(10);
    __free(p2);
    return: 0;
}
