# __alloc が返すアドレスは 0 以外であることを確認 #
func: __main() {
    let: ptr1(__alloc(1));
    let: ptr2(__alloc(5));
    let: ptr3(__alloc(100));
    # 各ポインタが 0 でなければ 1 を出力 #
    if: (ptr1 != 0) {
        __puti(1);
    } else: {
        __puti(0);
    };
    __putc(10);
    if: (ptr2 != 0) {
        __puti(1);
    } else: {
        __puti(0);
    };
    __putc(10);
    if: (ptr3 != 0) {
        __puti(1);
    } else: {
        __puti(0);
    };
    __putc(10);
    __free(ptr1);
    __free(ptr2);
    __free(ptr3);
    return: 0;
}
