# import weak 修飾子テスト: 衝突時に既存を優先 #
namespace: N1 {
  let: n1(10);
  let: n2(20);
}

namespace: M2 {
  import: weak: N1;
  let: n1(99);
  __trace(0);
  __assert(n1 == 99);   # M2$n1 を優先 #
  __assert(n2 == 20);   # N1$n2 を参照 #
  __assert(N1$n1 == 10); # N1$n1 は修飾名で参照可能 #
}

func: __main() {
  __trace(1);
}
