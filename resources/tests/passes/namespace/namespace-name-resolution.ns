# 名前空間内での名前解決優先順位テスト #
# 名前空間内では、プレフィックス付きの名前が外側の同名変数より優先される #
func: __main() {
  __trace(0);
  let: x(1);
  namespace: A {
    let: x(2);
    # x は A$x に解決される #
    __assert(x == 2);
    # 外側の x は名前空間内でも参照不可ではなく、A$x が優先 #
    let: z(x + 10);
    __assert(z == 12);
  }
  # 外側の x は変わらない #
  __assert(x == 1);
  __assert(A$x == 2);
}
