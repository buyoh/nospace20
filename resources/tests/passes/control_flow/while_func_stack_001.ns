# while loop in function does not corrupt caller locals #
# Minimal repro for Bug C: block values accumulate on stack #
# during while iterations, corrupting LOCAL_HEAP_BEGIN on deallocate #

func: loop_func(n) {
  let: i(0);
  while: i < n {
    i += 1;
  };
  return: 0;
}

func: main() {
  let: x(42);
  loop_func(3);
  __puti(x);
  return: 0;
}
