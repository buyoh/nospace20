# if 式の戻り値 #
func: main() {
  __trace(0);
  let:x;
  
  # if 式は then ブロックの最後の式の値を返す #
  x = if: 1 {
    5;
  } else: {
    10;
  };
  __assert(x == 5);
  
  # else ブロックの最後の式の値を返す #
  x = if: 0 {
    5;
  } else: {
    10;
  };
  __assert(x == 10);
  
  # 式の値を直接使用 #
  __assert(if: 1 { 42; } else: { 0; } == 42);
  __assert(if: 0 { 0; } else: { 99; } == 99);
  
  # 計算式の結果を返す #
  x = if: 1 {
    2 + 3;
  } else: {
    7 * 8;
  };
  __assert(x == 5);
  
  # ネストした if #
  x = if: 1 {
    if: 0 {
      10;
    } else: {
      20;
    };
  } else: {
    30;
  };
  __assert(x == 20);
}
