# while 文の使用 #
func: main() {
  __trace(0);
  let: i;

  # while 文は void 型 - 式文として使用可能 #
  i = 0;
  while: i - 3 {
    i = i + 1;
    i;
  };
  __assert(i == 3);

  # ループしない場合も文として使用可能 #
  while: 0 {
    42;
  };

  # break で抜けた場合も文として使用可能 #
  i = 0;
  while: 1 {
    i = i + 1;
    if: i - 5 {
    } else: {
      break:;
    };
  };
  __assert(i == 5);
  __trace(1);
}
