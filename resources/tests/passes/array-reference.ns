func: __main() {
    let: arr[3];
    let: p;
    p = &arr;
    *p = 99;
    __puti(arr[0]);
    __putc(10);

    *((&arr) + 1) = 50;
    __puti(arr[1]);
    __putc(10);

    let: q;
    q = &arr[2];
    *q = 77;
    __puti(arr[2]);
    __putc(10);

    let: arr2[3]([1, 2, 3]);
    let: ptr;
    let: i;
    ptr = &arr2;
    i = 0;
    while: i < 3 {
        *(ptr + i) = *(ptr + i) * 2;
        i = i + 1;
    };
    __puti(arr2[0]);
    __putc(10);
    __puti(arr2[1]);
    __putc(10);
    __puti(arr2[2]);
    __putc(10);
}
