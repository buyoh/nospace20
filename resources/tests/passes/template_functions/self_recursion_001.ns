# テンプレート関数の自己再帰テスト #
# foo は callback が真を返すまで自己再帰で合計を計算 #
func: foo(i), alias: func: callback() {
  if: callback(i) {
    return: i;
  };
  return: i + foo(i - 1);
}

func: is_zero(x) {
  return: x == 0;
}

alias: sum_down(foo, is_zero);

func: __main() {
  __puti(sum_down(5));   # 5+4+3+2+1+0=15 #
}
