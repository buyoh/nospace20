# Japanese comments test #
func: __main() {
  # 日本語のコメント #
  let:x;
  x = 1;
  # これは日本語のコメントです。漢字、ひらがな、カタカナが含まれています。 #
  __assert(x == 1);
  
  if:1{
    # ブロック内での日本語コメント #
    let:y;
    y = 2;
    # エラー: これはエラーではありません #
    __assert(y == 2);
  };
  
  # 未実装という文字列もコメント内では許可される #
  __assert(x == 1);
  
  # コロン: や括弧(){}[]も大丈夫 #
  # セミコロン; やカンマ, ピリオド. も使える #
  # 記号 !@$%^&*-=+|\/? も含められる #
  # Note: コメント終了記号であるハッシュ記号はコメント内に含められません #
}
