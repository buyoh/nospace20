# 後置添字演算子による読み取り: (expr)[i] #
# (expr)[i] は *(&(expr) + i) に脱糖される #
func: __main() {
  let: a;
  let: b;
  let: p;
  a = 100;
  b = 200;
  p = &a;   # p = a のアドレス #
  # (*p)[0] → *(&(*p) + 0) = *(p + 0) = *p = a = 100 #
  __puti((*p)[0]);
  __putc(10);
  let: arr[3];
  arr[0] = 10;
  arr[1] = 20;
  arr[2] = 30;
  let: q;
  q = &arr;
  # (*q)[0] = *(q + 0) = *q = *(&arr) = arr[0] = 10 #
  __puti((*q)[0]);
  __putc(10);
  # (*q)[1] = *(q + 1) = *(&arr + 1) = arr[1] = 20 #
  __puti((*q)[1]);
  __putc(10);
  # (*q)[2] = *(q + 2) = *(&arr + 2) = arr[2] = 30 #
  __puti((*q)[2]);
}
