# 後置添字演算子による読み取り: (*p)[i] #
# (*p)[i] は *((*p) + i) に脱糖される #
func: __main() {
  let: a;
  let: b;
  let: q;
  let: p;
  a = 100;
  b = 200;
  q = &a;   # q = a のアドレス #
  p = &q;   # p = q のアドレス #
  # (*p)[0] = *(*p + 0) = *(q + 0) = *(&a) = a = 100 #
  __puti((*p)[0]);
  __putc(10);
  # (*p)[1] = *(*p + 1) = *(q + 1) = *(&a + 1) = b = 200 #
  __puti((*p)[1]);
}
