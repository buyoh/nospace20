# 統合テスト: 複数機能の組み合わせ #
func: pow(a) {
  __trace(1);
  return: a * a;
}

func: __main() {
  __trace(0);
  let:x1; let:y1;
  let:x2; let:y2;
  x1=3; y1=4;
  x2=7; y2=3;
  let:result;
  result=pow(x2 - x1) + pow(y2 - y1);
  __assert(result == 17);
  
  let:a; let:b; let:i;
  a=1; b=1; i=8;
  while:i{
    let:tmp;
    tmp=a + b;
    a=b;
    b=tmp;
    i=i - 1;
  };
  __assert(b == 55);
}
