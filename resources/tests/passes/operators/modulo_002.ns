# 剰余演算子: 優先順位 (乗除算と同じ) #
func: __main() {
    let: a; let: b; let: c;
    
    # 7 + 10 % 3 は 7 + (10 % 3) = 7 + 1 = 8 #
    a = 7 + 10 % 3;
    __trace(0); __assert(a == 8);
    
    # 10 % 3 * 2 は (10 % 3) * 2 = 1 * 2 = 2 #
    b = 10 % 3 * 2;
    __trace(1); __assert(b == 2);
    
    # 20 / 3 % 2 は (20 / 3) % 2 = 6 % 2 = 0 #
    c = 20 / 3 % 2;
    __trace(2); __assert(c == 0);
    
    return: 0;
}
