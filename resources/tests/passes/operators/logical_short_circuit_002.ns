# 論理演算子: 短絡評価 (OR) #
# 左辺が非0ならば右辺は評価されない #

func: side_effect() {
    __trace(100);
    return: 1;
}

func: main() {
    let: a;
    # 左辺が1なので右辺は評価されない #
    a = 1 || side_effect();
    __trace(0); __assert(a == 1);
    
    # 左辺が0なので右辺も評価される #
    a = 0 || side_effect();
    __trace(1); __assert(a == 1);
    
    return: 0;
}
