# 括弧による優先順位の制御 #
func: __main() {
  __trace(0);
  let:x;
  x = (2 + 3) * 4;
  __assert(x == 20);  # 2+3=5, 5*4=20 #
  x = 2 * (3 + 4);
  __assert(x == 14);  # 3+4=7, 2*7=14 #
  x = (20 - 10) / 2;
  __assert(x == 5);   # 20-10=10, 10/2=5 #
  x = 3 * 4 / (1 + 2);
  __assert(x == 4);   # 3*4=12, 1+2=3, 12/3=4 #
}
