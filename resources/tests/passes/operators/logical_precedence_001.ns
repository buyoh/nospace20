# 論理演算子: 優先順位 #
# && は || より高い優先順位 #

func: __main() {
    let: a; let: b; let: c;
    
    # 1 || 0 && 0 は 1 || (0 && 0) = 1 || 0 = 1 #
    a = 1 || 0 && 0;
    __trace(0); __assert(a == 1);
    
    # 0 && 1 || 1 は (0 && 1) || 1 = 0 || 1 = 1 #
    b = 0 && 1 || 1;
    __trace(1); __assert(b == 1);
    
    # 比較演算子は論理演算子より高い優先順位 #
    # 1 < 2 && 3 > 2 は (1 < 2) && (3 > 2) = 1 && 1 = 1 #
    c = 1 < 2 && 3 > 2;
    __trace(2); __assert(c == 1);
    
    return: 0;
}
