# 後置添字演算子による書き込み: (*p)[i] = val #
# (*p)[i] は *((*p) + i) に脱糖される #
func: __main() {
  let: a;
  let: b;
  let: q;
  let: p;
  a = 0;
  b = 0;
  q = &a;   # q = a のアドレス #
  p = &q;   # p = q のアドレス #
  # (*p)[0] = 111 → *(*p + 0) = 111 → a = 111 #
  (*p)[0] = 111;
  __puti(a);
  __putc(10);
  # (*p)[1] = 222 → *(*p + 1) = 222 → b = 222 #
  (*p)[1] = 222;
  __puti(b);
}
