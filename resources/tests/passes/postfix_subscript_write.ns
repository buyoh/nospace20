# 後置添字演算子による書き込み: (expr)[i] = val #
# (expr)[i] は *(&(expr) + i) に脱糖される #
func: __main() {
  let: arr[3];
  arr[0] = 0;
  arr[1] = 0;
  arr[2] = 0;
  let: p;
  p = &arr;
  # (*p)[0] = 111 → *(&(*p) + 0) = *(p + 0) に 111 を格納 → arr[0] = 111 #
  (*p)[0] = 111;
  __puti(arr[0]);
  __putc(10);
  # (*p)[1] = 222 → *(p + 1) に 222 を格納 → arr[1] = 222 #
  (*p)[1] = 222;
  __puti(arr[1]);
  __putc(10);
  # (*p)[2] = 333 → *(p + 2) に 333 を格納 → arr[2] = 333 #
  (*p)[2] = 333;
  __puti(arr[2]);
}
