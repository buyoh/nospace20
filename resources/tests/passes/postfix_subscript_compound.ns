# 後置添字演算子による複合代入: (*p)[i] += val #
# (*p)[i] は *((*p) + i) に脱糖される #
func: __main() {
  let: a;
  let: b;
  let: q;
  let: p;
  a = 100;
  b = 200;
  q = &a;   # q = a のアドレス #
  p = &q;   # p = q のアドレス #
  # (*p)[0] += 11 → a += 11 = 111 #
  (*p)[0] += 11;
  __puti(a);
  __putc(10);
  # (*p)[1] += 22 → b += 22 = 222 #
  (*p)[1] += 22;
  __puti(b);
}
