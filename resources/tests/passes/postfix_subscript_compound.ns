# 後置添字演算子による複合代入: (expr)[i] += val #
# (expr)[i] は *(&(expr) + i) に脱糖される #
func: __main() {
  let: arr[3];
  arr[0] = 100;
  arr[1] = 200;
  arr[2] = 300;
  let: p;
  p = &arr;
  # (*p)[0] += 11 → arr[0] += 11 = 111 #
  (*p)[0] += 11;
  __puti(arr[0]);
  __putc(10);
  # (*p)[1] += 22 → arr[1] += 22 = 222 #
  (*p)[1] += 22;
  __puti(arr[1]);
  __putc(10);
  # (*p)[2] += 33 → arr[2] += 33 = 333 #
  (*p)[2] += 33;
  __puti(arr[2]);
}
