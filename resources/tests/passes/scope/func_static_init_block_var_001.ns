# 関数内 static 初期化子の中のブロック変数がグローバル変数・static 変数と重ならない（初期化子は外の非 static 変数を使えないので、初期化子の中で宣言する） #
# ルートの static はルートの初期化（①）で関数内 static 初期化子（②）より先に初期化されるため、上書きが観測できる #
static: g(1);
static: h(2);
func: f() {
  static: s1(4);
  static: s2({ let: t; t = s1 + 1; t; });
  static: s3({ let: a; let: b; a = 7; b = 8; a + b; });
  return: s1 * 100 + s2 * 10 + s3;
}
func: q() {
  static: s4({ let: t[2]; t[0] = 30; t[1] = 6; t[0] + t[1]; });
  return: s4;
}
func: __main() {
  __puti(g); __putc(32);
  __puti(h); __putc(32);
  __puti(f()); __putc(32);
  __puti(q()); __putc('\n');
  return: 0;
}
