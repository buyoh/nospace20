# Multi-level nested blocks #
func: main() {
  let:x;
  x = 1;
  if:1{
    let:y;
    y = 2;
    __assert(x == 1);
    if:1{
      let:z;
      z = 3;
      __assert(x == 1);
      __assert(y == 2);
      __assert(z == 3);
      x = 10;  # Modify variable 2 levels up #
      y = 20;  # Modify variable 1 level up #
    };
    __assert(x == 10);
    __assert(y == 20);
    # z is not accessible #
  };
  __assert(x == 10);
  # y is not accessible #
}
