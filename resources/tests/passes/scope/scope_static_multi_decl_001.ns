# 複数変数の static 宣言 #
func: test() {
  static: x, y, z;
  x = 1;
  y = 2;
  z = 3;
  
  func: inner() {
    __assert(x == 1);
    __assert(y == 2);
    __assert(z == 3);
    x = 10;
    y = 20;
    z = 30;
  }
  
  inner();
  __assert(x == 10);
  __assert(y == 20);
  __assert(z == 30);
}

func: main() {
  test();
}
