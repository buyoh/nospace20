# Nospace Grammar
#
# 現在の言語仕様 (docs/spec.md) に基づく BNF 定義
# 未実装の機能はコメントで注記

program ::= (func | global_stmt)*

## Tokens

integer ::= /[0-9]+/ | /0x[0-9A-Fa-f]+/
char ::= /'([^\\\t\n\s']|\\[\\tns'r])*'/
string_literal ::= /"([^"\\]|\\.)*"/
ident ::= /[A-Za-z_][A-Za-z0-9_]*/

## Whitespace (allowed between every token)

space ::= /[ \t\n\v\f\r]/
comment ::= /#[^#]*#/

## Expressions

# 優先順位（低い順）:
#   1. 代入 (=, +=, -=, *=, /=, %=)  - 右結合
#   2. 論理OR (||)                   - 左結合、短絡評価
#   3. 論理AND (&&)                  - 左結合、短絡評価
#   4. 比較 (==, !=, <, <=, >, >=)   - 左結合
#   5. 加減算 (+, -)                  - 左結合
#   6. 乗除剰余 (*, /, %)             - 左結合
#   7. 単項 (-, !, &, *)              - 右結合
#   8. インデックス ([])              - 左結合

expr ::= expr_assign
expr_assign ::= expr_or (("=" | "+=" | "-=" | "*=" | "/=" | "%=") expr_assign)?

expr_or ::= expr_and ("||" expr_or)?
expr_and ::= expr_cmp ("&&" expr_and)?

expr_cmp ::= expr_add (("==" | "!=" | "<" | "<=" | ">" | ">=") expr_cmp)?

expr_add ::= expr_mul (("+" | "-") expr_add)?
expr_mul ::= expr_unary (("*" | "/" | "%") expr_mul)?

expr_unary ::=
    | ("-" | "!" | "&" | "*") expr_unary
    | expr_postfix

expr_postfix ::=
    | expr_val "[" expr "]"                   # 配列インデックス
    | expr_val

expr_val ::=
    | integer
    | char
    | ident "(" (expr ("," expr)*)? ")"       # 関数呼び出し・ブロックエイリアス呼び出し
    | ident
    | "(" expr ")"
    | block                                    # ブロックスコープ式

## Statements

# グローバルスコープで許可される文
global_stmt ::=
    | let
    | static
    | final
    | constexpr
    | alias
    | expr ";"

func ::=
    | "func" ":" ident "(" (ident ("," ident)*)? ")" block
    | "func" ":" ident "(" (ident ("," ident)*)? ")" ("," "alias" ":" alias_param ("," alias_param)*)? block

alias_param ::=
    | "constexpr" ":" ident
    | "func" ":" ident ("(" (ident ("," ident)*)? ")")?
    | "static" ":" ident

let ::=
    | "let" ":" let_decl ("," let_decl)* ";"

static ::=
    | "static" ":" let_decl ("," let_decl)* ";"

final ::=
    | "final" ":" final_decl ("," final_decl)* ";"

final_decl ::= ident ("[" integer? "]")? ("(" array_init | string_init | expr ")")?

constexpr ::=
    | "constexpr" ":" ident "(" expr ")" ("," ident "(" expr ")")* ";"  # 式形式（複数定義可）
    | "constexpr" ":" ident block ";"                                    # ブロック形式（単一定義）

alias ::=
    | "alias" ":" ident "(" ident ")" ("," ident "(" ident ")")* ";"   # 識別子エイリアス
    | "alias" ":" ident "(" ident "," alias_arg ("," alias_arg)* ")" ("," ident "(" ident "," alias_arg ("," alias_arg)* ")")* ";"  # テンプレートインスタンス化
    | "alias" ":" ident block ";"                                       # ブロックエイリアス

alias_arg ::=
    | ident    # 関数名・static 変数名・constexpr 識別子
    | integer  # constexpr パラメータへの整数リテラル

let_decl ::= ident ("[" integer? "]")? ("(" array_init | string_init | expr ")")?
array_init ::= "[" expr ("," expr)* "]"
string_init ::= string_literal

stmt ::=
    | if_stmt
    | while_stmt
    | repeat_stmt
    | for_stmt
    | return_stmt
    | break_stmt
    | continue_stmt
    | let
    | static
    | final
    | constexpr
    | alias
    | func                                    # ネストした関数定義
    | expr ";"

# if 文
# 注: 旧仕様の elsif は廃止、else: if: で代用
if_stmt ::=
    | "if" ":" expr block ("else" ":" block)? ";"

# while 文
while_stmt ::=
    | "while" ":" expr block ";"

# repeat 文 (3形式)
# Form 1: カウンタ変数 + 上限値 + ボディ式
# Form 2: カウンタ変数 + ボディブロック（無限ループ）
# Form 3: ボディブロックのみ（無限ループ）
repeat_stmt ::=
    | "repeat" ":" ident "(" expr ")" "," expr "," expr ";"   # Form 1: i(init), N, body_expr
    | "repeat" ":" ident "(" expr ")" "," block ";"          # Form 2: i(init), body_block
    | "repeat" ":" block ";"                                  # Form 3: body_block

# for 文
for_stmt ::=
    | "for" ":" block block block block ";"                   # init, cond, step, body

# return 文
return_stmt ::=
    | "return" ":" expr ";"
    | "return" ":" ";"

# break / continue
break_stmt ::= "break" ":" ";"
continue_stmt ::= "continue" ":" ";"

block ::= "{" stmt* "}"

## 組み込み関数 (識別子として扱う)
#
# デバッグ・テスト用:
#   __clog(x)       - 値をコンソールに出力し、x を返す
#   __assert(x)     - x が 0 ならパニック
#   __assert_not(x) - x が 0 以外ならパニック
#   __trace(key)    - テスト用トレース記録
#
# 入出力:
#   __puti(x)       - 整数を出力
#   __putc(x)       - 文字（ASCII）を出力
#   __geti()        - 整数を入力
#   __getc()        - 1文字を入力

## 未実装機能
#
# - 多次元配列
